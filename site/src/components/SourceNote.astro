---
/** 글 끝 "데이터 기준" 블록 — 모든 데이터 리포트에 같은 모양으로 붙는 고정 영역.
 *
 *  왜 여기 있나: 종전에는 각주를 <small> 한 덩어리로 글 끝에 손으로 적었는데,
 *  ① 줄바꿈이 없어 읽기 어렵고 ② 글마다 문장이 조금씩 달라졌다.
 *  변하지 않는 3줄(관측 기준·예보 스냅샷·종합 산식)은 여기 한 곳에 두고,
 *  글마다 달라지는 것(기간·표본 수·그 글만의 단서)만 머리말에서 받는다.
 *
 *  ⚠ 고정 3줄을 고치면 **모든 글이 한꺼번에 바뀐다.** 채점 규칙이 바뀔 때만 손댄다.
 */
interface Props {
  period: string;
  scope: string;
  notes?: string[];
}
const { period, scope, notes = [] } = Astro.props;

/** 채점 규칙이 바뀌지 않는 한 모든 글에 그대로 붙는 문장 (SPEC 4장 기준) */
const FIXED = [
  '관측값은 기상청 자동기상관측망(AWS) 기준이며, 각 시·군·구에서 가장 가까운 지점을 정답지로 씁니다.',
  '예보는 전날 저녁에 저장한 스냅샷입니다. 모든 채널을 같은 시점·같은 기준으로 채점합니다.',
  '종합 적중률은 강수 50 : 기온 30 : 구름 20 가중평균입니다.',
];
---

<aside class="source-note">
  <h2>데이터 기준</h2>
  <dl>
    <div>
      <dt>대상 기간</dt>
      <dd>{period}</dd>
    </div>
    <div>
      <dt>표본</dt>
      <dd>{scope}</dd>
    </div>
  </dl>
  <ul>
    {FIXED.map((line) => <li>{line}</li>)}
    {notes.map((line) => <li class="own">{line}</li>)}
  </ul>
</aside>
