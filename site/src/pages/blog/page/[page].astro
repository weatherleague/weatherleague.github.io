---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { publishedPosts, PAGE_SIZE } from '../../../lib/posts';

/** 2페이지부터. 1페이지는 /blog/ (index.astro) — 글 상세 /blog/{slug}/ 와 경로가 겹치지
 *  않도록 목록 페이지에만 /page/ 세그먼트를 둔다. */
export async function getStaticPaths() {
  const all = await publishedPosts();
  const last = Math.ceil(all.length / PAGE_SIZE);
  const pages = [];
  for (let n = 2; n <= last; n++) {
    pages.push({
      params: { page: String(n) },
      props: { posts: all.slice((n - 1) * PAGE_SIZE, n * PAGE_SIZE), current: n, last },
    });
  }
  return pages;
}

const { posts, current, last } = Astro.props;
const title = `웨더리그 블로그 (${current}페이지)`;
const description = '실제 채점 기록으로 쓰는 예보 리포트와 업데이트 소식.';
---

<Base {title} {description} path={`/blog/page/${current}/`}>
  <section class="page-hero">
    <div class="container">
      <h1>웨더리그 블로그</h1>
      <p>실제 채점 기록으로 쓰는 예보 이야기, 그리고 업데이트 소식.</p>
    </div>
  </section>
  <div class="container">
    <PostList posts={posts} page={{ current, last }} />
  </div>
</Base>
