---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORY } from '../../lib/category';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = post.data.date;
const fmt = `${d.getFullYear()}. ${String(d.getMonth() + 1).padStart(2, '0')}. ${String(d.getDate()).padStart(2, '0')}`;

/** 구조화 데이터 — 검색엔진에 "이 페이지는 블로그 글이고, 제목·발행일·발행처는 이렇다"를
 *  기계가 읽는 형식으로 알려준다 (2026-08-09 신설. 그전에는 랜딩에만 있었다).
 *  머리말(title·description·date)에서 그대로 뽑으므로 글마다 따로 손댈 것이 없다. */
const site = Astro.site!.href.replace(/\/$/, '');
const postUrl = `${site}${base}/blog/${post.id}/`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: d.toISOString(),
  dateModified: d.toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  image: `${site}${base}${post.data.thumbnail ?? '/og-2608.png'}`,
  inLanguage: 'ko-KR',
  author: { '@type': 'Organization', name: '웨더리그', url: `${site}${base}/` },
  publisher: {
    '@type': 'Organization',
    name: '웨더리그',
    logo: { '@type': 'ImageObject', url: `${site}${base}/icon.png` },
  },
});
---

<Base
  title={`${post.data.title} — 웨더리그`}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  ogType="article"
  publishedTime={d.toISOString()}
  image={post.data.thumbnail}
  {jsonLd}
>
  <article class="post">
    <header class="post-hero">
      <div class="container narrow">
        <span class={`cat cat-${post.data.category}`}>{CATEGORY[post.data.category]}</span>
        <h1>{post.data.title}</h1>
        <p class="post-lede">{post.data.description}</p>
        <time datetime={d.toISOString()}>{fmt}</time>
      </div>
    </header>

    <div class="container narrow post-body">
      <Content />
    </div>

    <div class="container narrow">
      {/* 모든 글에 같은 문구로 붙는 고정 영역. 문안 변경은 이 한 곳만 고치면 전체 글에 반영된다. */}
      <div class="post-cta">
        <strong>우리 동네 날씨 순위가 궁금하다면?</strong>
        <p>
          우리 동네 1위 채널로 날씨를 알려주는 웨더리그 앱을 사용해보세요.<br />
          매일 채점해서 결과를 알려드려요.
        </p>
        <a class="btn btn-install" href="https://play.google.com/store/apps/details?id=com.weatherleague.app">앱 설치하기</a>
      </div>
      <a class="post-back" href={`${base}/blog/`}>← 블로그 목록으로</a>
    </div>
  </article>
</Base>
