---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORY } from '../../lib/category';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const title = '웨더리그 블로그';
const description =
  '동네별 예보 신뢰도 리포트와 웨더리그가 날씨를 채점하는 방법 이야기를 올리는 곳이에요.';
const fmt = (d: Date) =>
  `${d.getFullYear()}. ${String(d.getMonth() + 1).padStart(2, '0')}. ${String(d.getDate()).padStart(2, '0')}`;
---

<Base {title} {description} path="/blog/">
  <section class="page-hero">
    <div class="container">
      <h1>웨더리그 블로그</h1>
      <p>실제 채점 기록으로 쓰는 예보 이야기, 그리고 업데이트 소식.</p>
    </div>
  </section>

  <div class="container">
    {
      posts.length === 0 ? (
        <div class="empty-card">
          <span class="badge">준비 중</span>
          <h2>첫 글을 쓰고 있어요</h2>
          <p>어느 동네에서 어느 예보가 잘 맞는지, 실제 채점 데이터로 쓰는 리포트를 준비하고 있어요.</p>
        </div>
      ) : (
        <div class="post-list">
          {posts.map((post, i) => (
            <a class="post-card" href={`${base}/blog/${post.id}/`} data-reveal style={`--d:${i * 0.06}s`}>
              <div class="post-card-head">
                <span class={`cat cat-${post.data.category}`}>{CATEGORY[post.data.category]}</span>
                <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              {post.data.stat && (
                <div class="post-stat">
                  <strong>{post.data.stat}</strong>
                  <span>{post.data.statLabel}</span>
                </div>
              )}
              <span class="post-more">읽어보기 →</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Base>
