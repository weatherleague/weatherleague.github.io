---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts, PAGE_SIZE } from '../../lib/posts';

const all = await publishedPosts();
const posts = all.slice(0, PAGE_SIZE);
const last = Math.max(1, Math.ceil(all.length / PAGE_SIZE));

const title = '웨더리그 블로그';
const description =
  '실제 채점 기록으로 쓰는 예보 리포트와 업데이트 소식. 13개 예보 채널을 매일 채점한 데이터로 이야기합니다.';
---

<Base {title} {description} path="/blog/">
  <section class="page-hero">
    <div class="container">
      <h1>웨더리그 블로그</h1>
      <p>실제 채점 기록으로 쓰는 예보 이야기, 그리고 업데이트 소식.</p>
    </div>
  </section>

  <div class="container">
    {
      all.length === 0 ? (
        <div class="empty-card">
          <span class="badge">준비 중</span>
          <h2>첫 글을 쓰고 있어요</h2>
          <p>어느 동네에서 어느 예보가 잘 맞는지, 실제 채점 데이터로 쓰는 리포트를 준비하고 있어요.</p>
        </div>
      ) : (
        <PostList posts={posts} page={{ current: 1, last }} />
      )
    }
  </div>
</Base>
