---
// 예보 순위 — 전국 리그 / 지역 리그 (2026-08-13 디자인 정리판)
//
// ⚠ 이 페이지는 **미리보기 빌드에서만 생성된다** (아래 getStaticPaths 게이트).
//   본 사이트 공개 게이트 = "v4 종합순위 공개 가능 상태" (BACKLOG 웹 트랙 ③).
//   데이터는 전부 데모(고정 시드 더미) — 실제 순위를 싣지 않는다.
//
// 2026-08-13 개정 (운영자 디자인 피드백):
//   · 색 체계를 **사이트 브랜드 토큰**(global.css)으로 통일 — 종전의 베이지·회색
//     계열이 랜딩/앱과 따로 놀던 것이 "촌스럽다"의 근본 원인이었다.
//   · 외곽선 걷어내고 배경·그림자·여백으로 위계 (앱의 방향과 동일)
//   · 카피는 질문형·설명형을 버리고 정보형으로
//   · 지역 리그의 채널 패널을 브랜드 네이비 블록으로 (화면 중심 확보)
// 자산 생성기: 비공개 저장소 pipeline/build_league_map_assets.py
import Base from '../../layouts/Base.astro';
import LeagueMapSvg from '../../components/LeagueMapSvg.astro';

export function getStaticPaths() {
  // 갈리는 지점은 base=/preview 하나 (미리보기 사이트와 같은 판단 기준 — 불변 13)
  return import.meta.env.BASE_URL.replace(/\/$/, '') === '/preview'
    ? [{ params: { gate: undefined } }]
    : [];
}
---

<Base
  title="예보 순위 — 웨더리그"
  description="국내외 기상 모델의 예보 성적을 전국·지역별로 비교해 보세요."
  path="/league/"
>
  <main class="lgv2">
    <div class="container">
      <header class="lg-head">
        <h1>예보 순위</h1>
        <p class="lg-lede">국내외 기상 모델의 예보 성적을 전국·지역별로 비교해 보세요.</p>
      </header>

      <div class="lg-tabs" role="tablist" aria-label="보기 전환">
        <button id="tabNat" class="lg-tab on" type="button" role="tab"
                aria-selected="true" aria-controls="secNat">전국 리그</button>
        <button id="tabMap" class="lg-tab" type="button" role="tab"
                aria-selected="false" aria-controls="secMap">지역 리그</button>
      </div>

      <section id="secNat" class="lg-sec" role="tabpanel" aria-labelledby="tabNat">
        <div class="lg-sechead">
          <h2>전국 예보 순위</h2>
          <p>최근 30일 · 웨더리그 점수 기준</p>
        </div>
        <div id="natTop" class="lg-podium"></div>

        <div class="lg-panel">
          <h3 class="lg-panel-title">순위 변화</h3>
          <div id="natChart" class="lg-chartwrap"></div>
        </div>

        <div class="lg-panel">
          <h3 class="lg-panel-title">전체 순위</h3>
          <div id="natTable"></div>
        </div>
      </section>

      <section id="secMap" class="lg-sec" role="tabpanel" aria-labelledby="tabMap" hidden>
        <div class="lg-sechead">
          <h2>지역별 예보 순위</h2>
          <p>지역을 선택하면 상위 3개 채널을 볼 수 있습니다</p>
        </div>

        <div class="lg-controls">
          <div class="lg-search">
            <svg class="lg-search-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/>
            </svg>
            <input id="lgQ" type="search" placeholder="지역명을 입력하세요 (예: 강남구, 해운대구)"
                   autocomplete="off" aria-label="지역 검색" />
            <div id="lgQList" class="lg-qlist" hidden></div>
          </div>
          <button id="lgLoc" class="lg-cta-btn" type="button"
                  title="위치 정보는 브라우저 안에서만 사용하며 서버로 보내지 않습니다">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10Z"/>
              <circle cx="12" cy="11" r="2.4"/>
            </svg>
            우리 동네 보기
          </button>
        </div>

        <div class="lg-board">
          <div class="lg-rail" id="lgRail" role="group" aria-label="채널 선택"></div>
          <div class="lg-mapwrap" id="lgWrap">
            <LeagueMapSvg />
            <div id="lgLbls" class="lg-lbls" aria-hidden="true"></div>
            <div class="lg-zoom">
              <button id="lgZin" class="lg-mapbtn" type="button" aria-label="확대" title="확대">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </button>
              <button id="lgZout" class="lg-mapbtn" type="button" aria-label="축소" title="축소">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
              </button>
              <button id="lgZfit" class="lg-mapbtn" type="button" aria-label="전국 보기"
                      title="전국 보기">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 9V5h4M20 9V5h-4M4 15v4h4M20 15v4h-4"/>
                </svg>
              </button>
              <button id="lgHere" class="lg-mapbtn" type="button" aria-label="현재 위치"
                      title="현재 위치">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="4.2"/>
                  <path d="M12 2.6v3.2M12 18.2v3.2M2.6 12h3.2M18.2 12h3.2"/>
                </svg>
              </button>
            </div>
            <div id="lgTip" class="lg-tip" hidden></div>
            <div id="lgCard" class="lg-card" hidden></div>
            <div id="lgHud" class="lg-hud" hidden></div>
          </div>
        </div>
      </section>
    </div>

    <div id="lgToast" class="lg-toast" role="status"></div>
  </main>
</Base>

<style is:global>
  /* 색은 전부 사이트 브랜드 토큰(global.css)을 쓴다 — 랜딩·앱과 같은 계열 유지 */
  .lgv2 { padding: 30px 0 80px; }
  .lgv2 .lg-head { margin-bottom: 20px; }
  .lgv2 .lg-head h1 { font-size: 30px; letter-spacing: -0.04em; color: var(--ink);
    margin: 0; }
  .lgv2 .lg-lede { color: var(--muted); font-size: 15px; margin: 8px 0 0; }

  /* ── 탭 — 브랜드 네이비 채움으로 선택 상태를 분명히 ── */
  .lgv2 .lg-tabs { display: inline-flex; gap: 4px; background: var(--bg-soft);
    padding: 5px; border-radius: 14px; margin-bottom: 26px; }
  .lgv2 .lg-tab { border: 0; background: none; padding: 10px 22px; border-radius: 10px;
    font: inherit; font-size: 15px; font-weight: 600; color: var(--sub);
    cursor: pointer; letter-spacing: -0.03em; transition: background .18s, color .18s; }
  .lgv2 .lg-tab:hover { color: var(--ink); }
  .lgv2 .lg-tab.on { background: var(--deep); color: #fff;
    box-shadow: 0 4px 14px rgba(20, 42, 93, .22); }

  .lgv2 .lg-sechead { margin-bottom: 16px; }
  .lgv2 .lg-sechead h2 { font-size: 21px; letter-spacing: -0.035em; color: var(--ink);
    margin: 0; }
  .lgv2 .lg-sechead p { font-size: 14px; color: var(--muted); margin: 5px 0 0; }

  /* ── 카드·패널: 외곽선 없이 배경·그림자로 위계 ── */
  .lgv2 .lg-panel { background: #fff; border-radius: 18px; padding: 22px;
    box-shadow: 0 2px 10px rgba(22, 48, 79, .05), 0 12px 30px rgba(22, 48, 79, .05);
    margin-top: 18px; }
  .lgv2 .lg-panel-title { font-size: 16px; letter-spacing: -0.03em; color: var(--ink);
    margin: 0 0 14px; }

  /* ── 전국 시상대 ── */
  .lgv2 .lg-podium { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .lgv2 .lg-pod { background: var(--bg-soft); border-radius: 18px; padding: 20px 16px;
    text-align: center; }
  .lgv2 .lg-pod--1 { background: var(--deep); color: #fff;
    box-shadow: 0 10px 26px rgba(20, 42, 93, .24); }
  .lgv2 .lg-pod .rk { display: inline-block; font-size: 12px; font-weight: 700;
    color: var(--sub); background: rgba(22, 48, 79, .07); border-radius: 7px;
    padding: 3px 10px; letter-spacing: -0.02em; }
  .lgv2 .lg-pod--1 .rk { background: var(--gold); color: #1a1405; }
  .lgv2 .lg-pod .ic { display: block; margin: 13px auto 8px; }
  .lgv2 .lg-pod .nm { font-size: 15px; font-weight: 700; letter-spacing: -0.03em; }
  .lgv2 .lg-pod .sc { font-size: 30px; font-weight: 800; margin-top: 6px;
    font-variant-numeric: tabular-nums; letter-spacing: -0.04em; }
  .lgv2 .lg-pod .unit { font-size: 12px; font-weight: 500; color: var(--muted);
    display: block; margin-top: 2px; }
  .lgv2 .lg-pod--1 .unit { color: rgba(255, 255, 255, .62); }

  /* ── 차트 ── */
  .lgv2 .lg-chartwrap { position: relative; }
  .lgv2 .lg-chartwrap svg { display: block; width: 100%; height: auto; }
  .lgv2 .lg-chartwrap .grid { stroke: rgba(22, 48, 79, .08); stroke-width: 1; }
  .lgv2 .lg-chartwrap .axis { font-size: 11px; fill: var(--muted); }
  .lgv2 .lg-chartwrap .ln { fill: none; stroke-width: 2.2; stroke-linejoin: round;
    stroke-linecap: round; }
  .lgv2 .lg-chartwrap .ln--sub { stroke-width: 1.3; opacity: .38; }
  .lgv2 .lg-chartwrap .dot { stroke: #fff; stroke-width: 2; }
  .lgv2 .lg-chartwrap .cross { stroke: rgba(22, 48, 79, .28); stroke-width: 1;
    stroke-dasharray: 3 3; }
  .lgv2 .lg-chartwrap .endlbl { font-size: 11.5px; font-weight: 600;
    letter-spacing: -0.03em; }
  .lgv2 .lg-chartwrap .endlbl--sub { font-size: 11px; font-weight: 500; opacity: .72; }
  .lgv2 .lg-cttip { position: absolute; pointer-events: none; background: #fff;
    border-radius: 12px; padding: 11px 13px; font-size: 13px; min-width: 178px;
    box-shadow: 0 6px 28px rgba(22, 48, 79, .18); }
  .lgv2 .lg-cttip .dt { font-size: 11.5px; color: var(--muted); margin-bottom: 6px; }
  .lgv2 .lg-cttip .r { display: flex; align-items: center; gap: 7px; padding: 3px 0; }
  .lgv2 .lg-cttip .r .rk { width: 24px; color: var(--muted); font-size: 11.5px; }
  .lgv2 .lg-cttip .r .nm { flex: 1; letter-spacing: -0.03em; }
  .lgv2 .lg-cttip .r .sc { font-weight: 700; font-variant-numeric: tabular-nums; }

  /* ── 표 (항상 펼쳐 둔다) ── */
  .lgv2 .lg-tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
  .lgv2 .lg-tbl th { font-size: 12px; color: var(--muted); font-weight: 600;
    text-align: left; padding: 0 10px 10px; }
  .lgv2 .lg-tbl th.num, .lgv2 .lg-tbl td.num { text-align: right; }
  .lgv2 .lg-tbl td { padding: 11px 10px; border-top: 1px solid rgba(22, 48, 79, .07); }
  .lgv2 .lg-tbl tr:first-child td { border-top: 0; }
  .lgv2 .lg-tbl .ch { display: flex; align-items: center; gap: 9px;
    letter-spacing: -0.03em; }
  .lgv2 .lg-tbl .rk { color: var(--muted); font-variant-numeric: tabular-nums;
    width: 34px; }
  .lgv2 .lg-tbl tr.top td .rk { color: var(--ink); font-weight: 700; }
  .lgv2 .lg-tbl .sc { font-weight: 700; font-variant-numeric: tabular-nums; }
  .lgv2 .lg-tbl .dl { font-variant-numeric: tabular-nums; font-size: 13px; }
  .lgv2 .lg-tbl .dl--up { color: var(--green); }
  .lgv2 .lg-tbl .dl--dn { color: var(--red); }
  .lgv2 .lg-tbl .dl--same { color: var(--muted); }

  /* ── 지역 리그: 상단 컨트롤 바 ── */
  .lgv2 .lg-controls { display: flex; gap: 10px; margin-bottom: 12px; }
  .lgv2 .lg-search { position: relative; flex: 1; }
  .lgv2 .lg-search-ic { position: absolute; left: 16px; top: 50%; width: 18px;
    height: 18px; transform: translateY(-50%); color: var(--muted); }
  .lgv2 .lg-search input { width: 100%; padding: 15px 18px 15px 44px; font-size: 15px;
    border: 0; border-radius: 14px; background: var(--bg-soft); font-family: inherit;
    color: var(--ink); letter-spacing: -0.03em; }
  .lgv2 .lg-search input::placeholder { color: var(--muted); }
  .lgv2 .lg-search input:focus { outline: 2px solid var(--blue); outline-offset: -2px;
    background: #fff; }
  .lgv2 .lg-qlist { position: absolute; top: calc(100% + 6px); left: 0; right: 0;
    background: #fff; border-radius: 14px; z-index: 30; overflow: hidden;
    box-shadow: 0 10px 34px rgba(22, 48, 79, .16); }
  .lgv2 .lg-qlist button { display: block; width: 100%; text-align: left;
    padding: 12px 18px; border: 0; background: none; font: inherit; font-size: 14.5px;
    color: var(--ink); cursor: pointer; letter-spacing: -0.03em; }
  .lgv2 .lg-qlist button:hover { background: var(--bg-soft); }
  .lgv2 .lg-cta-btn { display: inline-flex; align-items: center; gap: 8px; border: 0;
    padding: 15px 24px; border-radius: 14px; background: var(--deep); color: #fff;
    font: inherit; font-size: 15px; font-weight: 700; cursor: pointer;
    letter-spacing: -0.03em; white-space: nowrap;
    box-shadow: 0 6px 18px rgba(20, 42, 93, .24); transition: background .18s; }
  .lgv2 .lg-cta-btn:hover { background: var(--brand); }
  .lgv2 .lg-cta-btn[disabled] { opacity: .55; cursor: wait; }
  .lgv2 .lg-cta-btn svg { width: 18px; height: 18px; }

  /* ── 채널 패널(네이비 블록) + 지도 ── */
  .lgv2 .lg-board { display: flex; gap: 10px; align-items: stretch; }
  .lgv2 .lg-rail { flex: 0 0 208px; display: flex; flex-direction: column; gap: 2px;
    background: var(--deep); border-radius: 18px; padding: 10px;
    box-shadow: 0 10px 30px rgba(20, 42, 93, .18); }
  .lgv2 .lg-rail button { display: flex; align-items: center; gap: 9px; width: 100%;
    padding: 9px 11px; border: 0; background: none; border-radius: 11px; font: inherit;
    font-size: 13.5px; color: rgba(255, 255, 255, .82); cursor: pointer;
    text-align: left; letter-spacing: -0.03em; transition: background .16s, color .16s; }
  .lgv2 .lg-rail button:hover { background: rgba(255, 255, 255, .10); color: #fff; }
  .lgv2 .lg-rail button.on { background: #fff; color: var(--ink); font-weight: 700;
    box-shadow: 0 3px 12px rgba(0, 0, 0, .18); }
  .lgv2 .lg-rail .nm { flex: 1; white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; }
  .lgv2 .lg-rail .ct { font-size: 12px; color: rgba(255, 255, 255, .48);
    font-variant-numeric: tabular-nums; }
  .lgv2 .lg-rail button.on .ct { color: var(--muted); }

  .lgv2 .lg-mapwrap { position: relative; background: #eef4fa; border-radius: 18px;
    overflow: hidden; flex: 1; min-width: 0; }
  .lgv2 #lgMap { display: block; width: 100%; height: auto; touch-action: none; }
  /* 경계선 3단 위계 — 굵기를 전반적으로 낮춰 정제된 인상으로 (2026-08-13) */
  .lgv2 #lgMap path { stroke: rgba(22, 48, 79, .20); stroke-width: .55; cursor: pointer;
    vector-effect: non-scaling-stroke; transform-box: fill-box; transform-origin: 50% 50%;
    transition: fill .2s ease, filter .2s ease, transform .2s cubic-bezier(.2,.7,.3,1); }
  .lgv2 #lgMap path.sel { stroke: #fff; stroke-width: 1.4;
    filter: drop-shadow(0 3px 6px rgba(20, 42, 93, .4)); }
  .lgv2 #lgSidoLines path { fill: none; stroke: rgba(22, 48, 79, .42); stroke-width: .9;
    pointer-events: none; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .lgv2 #lgNeighbors path { fill: #e3eaf2; stroke: rgba(22, 48, 79, .10);
    stroke-width: .6; vector-effect: non-scaling-stroke; pointer-events: none; }
  .lgv2 #lgRegions { filter: drop-shadow(0 1px 1.5px rgba(22, 48, 79, .14)); }
  /* 고른 채널이 1위인 지역 — 부드럽게 떠오른다 */
  .lgv2 #lgMap path.won { stroke: rgba(255, 255, 255, .92); stroke-width: 1;
    transform: translateY(-2px) scale(1.02);
    filter: drop-shadow(0 4px 7px rgba(20, 42, 93, .42)); }
  @media (prefers-reduced-motion: reduce) {
    .lgv2 #lgMap path { transition: none; }
    .lgv2 #lgMap path.won { transform: none; }
  }

  /* 지명 라벨 — SVG 밖 HTML 오버레이 (확대해도 글자가 또렷하다) */
  .lgv2 .lg-lbls { position: absolute; inset: 0; pointer-events: none; z-index: 5;
    overflow: hidden; }
  .lgv2 .lg-lbl { position: absolute; left: 0; top: 0; white-space: nowrap;
    font-size: 11px; font-weight: 600; color: var(--ink); letter-spacing: -0.03em;
    text-shadow: 0 1px 2.5px #fff, 0 -1px 2.5px #fff, 1px 0 2.5px #fff,
      -1px 0 2.5px #fff, 0 0 4px #fff; will-change: transform; }
  .lgv2 .lg-lbl--sido { font-size: 12.5px; font-weight: 700; padding: 2px 8px;
    border-radius: 8px; background: rgba(255, 255, 255, .84); text-shadow: none;
    box-shadow: 0 1px 4px rgba(22, 48, 79, .10); }

  .lgv2 .lg-zoom { position: absolute; right: 12px; top: 12px; display: flex;
    flex-direction: column; gap: 6px; }
  .lgv2 .lg-mapbtn { width: 40px; height: 40px; display: inline-flex;
    align-items: center; justify-content: center; border: 0; border-radius: 12px;
    background: rgba(255, 255, 255, .94); color: var(--ink); cursor: pointer;
    box-shadow: 0 2px 10px rgba(22, 48, 79, .16); transition: background .16s; }
  .lgv2 .lg-mapbtn:hover { background: #fff; }
  .lgv2 .lg-mapbtn svg { width: 18px; height: 18px; }

  .lgv2 .lg-tip { position: absolute; pointer-events: none; background: var(--ink);
    color: #fff; font-size: 12.5px; padding: 6px 10px; border-radius: 8px; z-index: 20;
    white-space: nowrap; letter-spacing: -0.03em; }

  /* ── 지역 결과 카드 ── */
  .lgv2 .lg-flag { width: 19px; height: 13px; object-fit: cover; border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(22, 48, 79, .12); flex: none; }
  .lgv2 .lg-flag--sq { width: 16px; height: 16px; object-fit: contain; border-radius: 0;
    box-shadow: none; }
  .lgv2 .lg-card { position: absolute; z-index: 25; width: 262px; background: #fff;
    border-radius: 16px; padding: 16px; box-shadow: 0 12px 40px rgba(22, 48, 79, .22); }
  .lgv2 .lg-cardhead { display: flex; align-items: baseline; gap: 8px;
    margin-bottom: 12px; padding-right: 22px; }
  .lgv2 .lg-cardhead b { font-size: 15.5px; letter-spacing: -0.035em; color: var(--ink); }
  .lgv2 .lg-cardhead span { font-size: 11.5px; color: var(--muted); flex: none; }
  .lgv2 .lg-x { position: absolute; top: 10px; right: 10px; width: 26px; height: 26px;
    border: 0; background: none; font-size: 14px; color: var(--muted); cursor: pointer;
    border-radius: 8px; }
  .lgv2 .lg-x:hover { background: var(--bg-soft); }
  .lgv2 .lg-row { display: flex; align-items: center; gap: 9px; padding: 8px 0;
    font-size: 14px; color: var(--ink); }
  .lgv2 .lg-row + .lg-row { border-top: 1px solid rgba(22, 48, 79, .07); }
  .lgv2 .lg-rank { flex: none; width: 30px; height: 21px; border-radius: 7px;
    font-size: 11.5px; font-weight: 700; display: inline-flex; align-items: center;
    justify-content: center; background: var(--bg-soft); color: var(--sub); }
  .lgv2 .lg-rank--top { background: var(--gold); color: #1a1405; }
  .lgv2 .lg-row .nm { flex: 1; letter-spacing: -0.03em; }
  .lgv2 .lg-row .sc { font-weight: 700; font-variant-numeric: tabular-nums; }
  .lgv2 .lg-schead { font-size: 11.5px; color: var(--muted); text-align: right;
    margin-bottom: 2px; }
  .lgv2 .lg-cta { display: block; text-align: center; margin-top: 13px; padding: 12px;
    background: var(--deep); color: #fff; border-radius: 12px; text-decoration: none;
    font-size: 14px; font-weight: 600; letter-spacing: -0.03em; }
  .lgv2 .lg-collect { background: var(--bg-soft); border-radius: 12px; padding: 14px;
    font-size: 13.5px; color: var(--sub); line-height: 1.55; }
  .lgv2 .lg-collect b { display: block; margin-bottom: 3px; color: var(--ink); }

  /* 모바일: 지도 하단 얇은 HUD */
  .lgv2 .lg-hud { position: absolute; left: 10px; right: 10px; bottom: 10px; z-index: 25;
    background: rgba(255, 255, 255, .97); border-radius: 15px; padding: 11px 13px;
    box-shadow: 0 8px 26px rgba(22, 48, 79, .2); backdrop-filter: blur(4px); }
  .lgv2 .lg-hudhead { display: flex; align-items: baseline; gap: 7px; padding-right: 24px;
    margin-bottom: 5px; }
  .lgv2 .lg-hudhead b { font-size: 14px; letter-spacing: -0.035em; color: var(--ink); }
  .lgv2 .lg-hudhead span { font-size: 11px; color: var(--muted); }
  .lgv2 .lg-hrow { display: flex; align-items: center; gap: 8px; padding: 5px 0;
    font-size: 13.5px; color: var(--ink); }
  .lgv2 .lg-hrow + .lg-hrow { border-top: 1px solid rgba(22, 48, 79, .06); }
  .lgv2 .lg-hrow .lg-rank { width: 27px; height: 19px; font-size: 11px; border-radius: 6px; }
  .lgv2 .lg-hrow .nm { flex: 1; letter-spacing: -0.03em; }
  .lgv2 .lg-hrow .sc { font-weight: 700; font-variant-numeric: tabular-nums; }
  .lgv2 .lg-hudcta { display: block; margin-top: 8px; padding: 11px; background: var(--deep);
    color: #fff; border-radius: 11px; text-align: center; text-decoration: none;
    font-size: 13.5px; font-weight: 600; letter-spacing: -0.03em; }

  .lgv2 .lg-toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%);
    background: var(--ink); color: #fff; font-size: 13.5px; padding: 11px 18px;
    border-radius: 12px; opacity: 0; transition: opacity .15s; z-index: 70;
    pointer-events: none; max-width: 92vw; text-align: center; letter-spacing: -0.03em;
    box-shadow: 0 10px 30px rgba(22, 48, 79, .3); }
  .lgv2 .lg-toast.on { opacity: 1; }

  @media (max-width: 900px) {
    .lgv2 .lg-podium { grid-template-columns: 1fr; }
    .lgv2 .lg-pod { display: flex; align-items: center; gap: 12px; text-align: left;
      padding: 14px 16px; }
    .lgv2 .lg-pod .ic { margin: 0; }
    .lgv2 .lg-pod .nm { flex: 1; }
    .lgv2 .lg-pod .sc { font-size: 22px; margin-top: 0; }
    .lgv2 .lg-pod .unit { display: inline; margin-left: 4px; }
  }
  @media (max-width: 768px) {
    .lgv2 .lg-head h1 { font-size: 25px; }
    .lgv2 .lg-tabs { display: flex; width: 100%; }
    .lgv2 .lg-tab { flex: 1; padding: 10px 12px; }
    .lgv2 .lg-controls { flex-direction: column; }
    .lgv2 .lg-cta-btn { justify-content: center; }
    .lgv2 .lg-board { flex-direction: column; gap: 10px; }
    .lgv2 .lg-rail { flex: none; width: 100%; flex-direction: row; overflow-x: auto;
      padding: 8px; gap: 6px; scrollbar-width: none; }
    .lgv2 .lg-rail::-webkit-scrollbar { display: none; }
    .lgv2 .lg-rail button { width: auto; flex: none; padding: 8px 12px; }
    .lgv2 .lg-rail .ct { display: none; }
    .lgv2 .lg-card { display: none !important; }
    .lgv2 .lg-panel { padding: 16px; }
  }
  @media (min-width: 769px) { .lgv2 .lg-hud { display: none !important; } }
</style>

<script>
  // ── 상태 ────────────────────────────────────────────────────────────
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const svg = document.getElementById('lgMap');
  const wrap = document.getElementById('lgWrap');
  // FULL = SVG 전체 범위(팬 한계) / VB = 첫 화면 틀 (demo.json home)
  const FULL = { x: 0, y: 0, w: 760, h: 821 };
  let VB = { ...FULL };
  let vb = { ...VB };
  let DATA = null;
  let judge = null;         // 판정용 경계 (위치 기능 첫 사용 때만 로드)
  let selected = null;
  let activeCh = null;

  const $ = (id) => document.getElementById(id);
  const isMobile = () => matchMedia('(max-width: 768px)').matches;

  // 수집 중 상태 확인은 내부용 주소 매개변수로만 (?state=collecting)
  const collecting = new URLSearchParams(location.search).get('state') === 'collecting';
  const COLLECT_FILL = '#dfe6ee';
  const IDLE_FILL = '#dbe4ee';   // 아무 채널도 안 고른 상태
  const REST_FILL = '#e6ecf3';   // 채널을 골랐을 때 그 외 지역

  // 지도 카드 폭을 지도 비율에 맞춘다 (좌우 빈 바다 제거)
  function fitCard() {
    if (!wrap || !VB.w) return;
    if (isMobile()) { wrap.style.maxWidth = ''; return; }
    const maxH = Math.min(innerHeight * 0.82, 820);
    wrap.style.maxWidth = `${Math.round(maxH * (VB.w / VB.h))}px`;
  }
  addEventListener('resize', () => { fitCard(); scheduleLabels(); });

  // ── 데이터 로드 ─────────────────────────────────────────────────────
  fetch(`${base}/league/demo.json`, { cache: 'no-cache' }).then((r) => r.json()).then((d) => {
    DATA = d;
    if (d.home) {
      const [hx, hy, hw, hh] = d.home;
      VB = { x: hx, y: hy, w: hw, h: hh };
      vb = { ...VB };
      fitCard();
      applyVB();
    }
    paint();
    buildRail();
    buildLabels();
    updateLabels();
    buildNational();
  });

  function paint() {
    if (!DATA) return;
    // ⚠ 반드시 `path[data-g]`만 — 그냥 `path`로 돌면 시도 경계선 레이어까지 칠해져
    //   지도 전체에 회색 막이 덮인다 (2026-08-12 실사고).
    for (const p of svg.querySelectorAll('path[data-g]')) {
      const r = DATA.regions[p.dataset.g];
      p.classList.remove('won');
      if (collecting || !r) { p.style.fill = COLLECT_FILL; continue; }
      if (!activeCh) { p.style.fill = IDLE_FILL; continue; }
      if (r.t[0][0] === activeCh) {
        p.style.fill = DATA.channels[activeCh].c;
        p.classList.add('won');
      } else {
        p.style.fill = REST_FILL;
      }
    }
    if (activeCh) {   // 떠오른 지역을 맨 위로 (그림자가 이웃에 가리지 않게)
      const g = svg.querySelector('#lgRegions');
      svg.querySelectorAll('#lgRegions path.won').forEach((p) => g.appendChild(p));
    }
  }

  function chIcon(code, cls = 'lg-flag') {
    const ch = DATA.channels[code];
    const sq = ch.i.endsWith('.svg') ? ' lg-flag--sq' : '';
    return `<img class="${cls}${sq}" src="${base}/league/ch/${ch.i}" alt="">`;
  }

  // 채널 목록 (국가별 고정 순서) — 1위 지역 수를 함께 보여준다
  function buildRail() {
    const rail = $('lgRail');
    const wins = {};
    for (const r of Object.values(DATA.regions)) {
      wins[r.t[0][0]] = (wins[r.t[0][0]] || 0) + 1;
    }
    rail.innerHTML = Object.entries(DATA.channels)
      .filter(([code]) => code !== 'om_kma' || wins[code])   // 미공개 채널은 숨김
      .map(([code, ch]) => `<button type="button" data-ch="${code}">
        ${chIcon(code)}<span class="nm">${ch.n}</span>
        <span class="ct">${wins[code] || 0}</span></button>`).join('');
    rail.addEventListener('click', (e) => {
      const b = e.target.closest('button[data-ch]');
      if (!b) return;
      activeCh = activeCh === b.dataset.ch ? null : b.dataset.ch;   // 다시 누르면 해제
      rail.querySelectorAll('button').forEach((x) =>
        x.classList.toggle('on', x.dataset.ch === activeCh));
      paint();
    });
  }

  // ── 지명 라벨 (HTML 오버레이) ───────────────────────────────────────
  const lbls = $('lgLbls');
  let sidoEls = [], sggEls = [];
  function buildLabels() {
    for (const s of DATA.sido) {
      const el = document.createElement('span');
      el.className = 'lg-lbl lg-lbl--sido';
      el.textContent = s.n;
      el.dataset.x = s.c[0];
      el.dataset.y = s.c[1];
      lbls.appendChild(el);
      sidoEls.push(el);
    }
    for (const r of Object.values(DATA.regions)) {
      const el = document.createElement('span');
      el.className = 'lg-lbl';
      el.textContent = r.s;
      el.dataset.x = r.c[0];
      el.dataset.y = r.c[1];
      el.dataset.w = r.b[2];
      el.dataset.chars = r.s.length;
      lbls.appendChild(el);
      sggEls.push(el);
    }
  }
  function placeLabel(el, rc, offX, offY) {
    const sx = ((+el.dataset.x - vb.x) / vb.w) * rc.width + offX;
    const sy = ((+el.dataset.y - vb.y) / vb.h) * rc.height + offY;
    if (sx < -50 || sx > rc.width + 50 || sy < -20 || sy > rc.height + 20) {
      el.style.display = 'none';
      return;
    }
    el.style.display = '';
    el.style.transform = `translate(${sx.toFixed(1)}px,${sy.toFixed(1)}px) translate(-50%,-50%)`;
  }
  function updateLabels() {
    if (!sidoEls.length) return;
    const rc = svg.getBoundingClientRect();
    const wrc = wrap.getBoundingClientRect();
    const offX = rc.left - wrc.left, offY = rc.top - wrc.top;
    const scale = vb.w / (rc.width || 1);
    const sidoOn = vb.w > VB.w / 2.2;
    for (const el of sidoEls) {
      if (!sidoOn) { el.style.display = 'none'; continue; }
      placeLabel(el, rc, offX, offY);
    }
    for (const el of sggEls) {
      // 등장 문턱은 **그 라벨이 실제로 차지할 폭** 기준 (글자 수 반영)
      const needPx = +el.dataset.chars * 11 + 10;
      if (sidoOn || (+el.dataset.w / scale) <= needPx) { el.style.display = 'none'; continue; }
      placeLabel(el, rc, offX, offY);
    }
  }
  let lblRaf = false;
  function scheduleLabels() {
    if (lblRaf) return;
    lblRaf = true;
    requestAnimationFrame(() => { lblRaf = false; updateLabels(); });
  }

  // ── viewBox 줌·팬 ───────────────────────────────────────────────────
  const MINW = FULL.w / 24;          // 최대 줌 24배
  function applyVB() {
    svg.setAttribute('viewBox', `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
    scheduleLabels();
  }
  function clampPan() {
    vb.x = Math.min(Math.max(vb.x, FULL.x - vb.w * 0.25), FULL.x + FULL.w - vb.w * 0.75);
    vb.y = Math.min(Math.max(vb.y, FULL.y - vb.h * 0.25), FULL.y + FULL.h - vb.h * 0.75);
  }
  function svgPt(clientX, clientY) {
    const rc = svg.getBoundingClientRect();
    return { x: vb.x + ((clientX - rc.left) / rc.width) * vb.w,
             y: vb.y + ((clientY - rc.top) / rc.height) * vb.h };
  }
  function zoomAt(px, py, f) {
    const w = Math.min(Math.max(vb.w / f, MINW), FULL.w);
    const real = vb.w / w;
    vb.x = px - (px - vb.x) / real;
    vb.y = py - (py - vb.y) / real;
    vb.w = w;
    vb.h = VB.h * (w / VB.w);
    clampPan();
    applyVB();
  }
  function animateTo(target, ms = 260) {
    const from = { ...vb };
    const t0 = performance.now();
    (function step(t) {
      const k = Math.min(1, (t - t0) / ms);
      const e = 1 - (1 - k) * (1 - k);
      vb = { x: from.x + (target.x - from.x) * e,
             y: from.y + (target.y - from.y) * e,
             w: from.w + (target.w - from.w) * e,
             h: from.h + (target.h - from.h) * e };
      applyVB();
      if (k < 1) requestAnimationFrame(step);
    })(t0);
  }
  function zoomToRegion(g) {
    const b = DATA.regions[g].b;
    const w = Math.min(Math.max(Math.max(b[2] * 4.5, (b[3] * 4.5 * VB.w) / VB.h),
      MINW), FULL.w);
    const h = VB.h * (w / VB.w);
    animateTo({ x: b[0] + b[2] / 2 - w / 2, y: b[1] + b[3] / 2 - h / 2, w, h });
  }

  svg.addEventListener('wheel', (e) => {
    e.preventDefault();
    const p = svgPt(e.clientX, e.clientY);
    zoomAt(p.x, p.y, e.deltaY < 0 ? 1.3 : 1 / 1.3);
  }, { passive: false });

  // 포인터: 1개 = 팬 / 2개 = 핀치.
  // ⚠ setPointerCapture가 click 대상을 svg로 바꾸므로 선택은 pointerup에서 판정한다.
  const ptrs = new Map();
  let panFrom = null, pinchD = 0, movedPx = 0, downG = null, downAt = null;
  svg.addEventListener('pointerdown', (e) => {
    try { svg.setPointerCapture(e.pointerId); } catch { /* 합성 이벤트 등 */ }
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    movedPx = 0;
    if (ptrs.size === 1) {
      downG = e.target?.dataset?.g || null;
      downAt = { x: e.clientX, y: e.clientY };
      panFrom = { cx: e.clientX, cy: e.clientY, vb: { ...vb } };
    } else if (ptrs.size === 2) {
      downG = null;
      panFrom = null;
      const [a, b] = [...ptrs.values()];
      pinchD = Math.hypot(a.x - b.x, a.y - b.y);
    }
  });
  svg.addEventListener('pointermove', (e) => {
    if (!ptrs.has(e.pointerId)) return;
    ptrs.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (ptrs.size === 2) {
      const [a, b] = [...ptrs.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinchD > 0 && d > 0) {
        const mid = svgPt((a.x + b.x) / 2, (a.y + b.y) / 2);
        zoomAt(mid.x, mid.y, d / pinchD);
      }
      pinchD = d;
      movedPx = 99;
    } else if (panFrom) {
      const rc = svg.getBoundingClientRect();
      const dx = ((e.clientX - panFrom.cx) / rc.width) * panFrom.vb.w;
      const dy = ((e.clientY - panFrom.cy) / rc.height) * panFrom.vb.h;
      movedPx = Math.max(movedPx,
        Math.abs(e.clientX - panFrom.cx) + Math.abs(e.clientY - panFrom.cy));
      vb.x = panFrom.vb.x - dx;
      vb.y = panFrom.vb.y - dy;
      clampPan();
      applyVB();
    }
  });
  function ptrEnd(e) {
    ptrs.delete(e.pointerId);
    if (ptrs.size < 2) pinchD = 0;
    if (ptrs.size === 0) {
      panFrom = null;
      if (e.type === 'pointerup' && movedPx <= 6) {
        if (downG) select(downG, downAt);
        else deselect();
      }
      downG = null;
    }
  }
  svg.addEventListener('pointerup', ptrEnd);
  svg.addEventListener('pointercancel', ptrEnd);

  $('lgZin').addEventListener('click', () =>
    zoomAt(vb.x + vb.w / 2, vb.y + vb.h / 2, 1.5));
  $('lgZout').addEventListener('click', () =>
    zoomAt(vb.x + vb.w / 2, vb.y + vb.h / 2, 1 / 1.5));
  $('lgZfit').addEventListener('click', () => animateTo({ ...VB }));

  // 호버 = 지역명만
  const tip = $('lgTip');
  svg.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch' || ptrs.size > 0) { tip.hidden = true; return; }
    const g = e.target?.dataset?.g;
    if (!g || !DATA) { tip.hidden = true; return; }
    tip.textContent = DATA.regions[g].n;
    const rc = wrap.getBoundingClientRect();
    tip.style.left = `${Math.min(e.clientX - rc.left + 14, rc.width - 130)}px`;
    tip.style.top = `${e.clientY - rc.top + 16}px`;
    tip.hidden = false;
  });
  svg.addEventListener('pointerleave', () => { tip.hidden = true; });

  // ── 지역 결과 (PC 플로팅 카드 / 모바일 HUD) ─────────────────────────
  function rowsHTML(g, hud) {
    const r = DATA.regions[g];
    const rowCls = hud ? 'lg-hrow' : 'lg-row';
    return r.t.map(([c, s], i) => `
      <div class="${rowCls}">
        <span class="lg-rank${i === 0 ? ' lg-rank--top' : ''}">${i + 1}위</span>
        ${chIcon(c)}
        <span class="nm">${DATA.channels[c].n}</span>
        <span class="sc">${s}</span>
      </div>`).join('');
  }
  function cardHTML(g) {
    const r = DATA.regions[g];
    if (collecting) {
      return `<button class="lg-x" aria-label="닫기">✕</button>
        <div class="lg-cardhead"><b>${r.n}</b></div>
        <div class="lg-collect"><b>순위를 집계하고 있습니다</b>
        새 채점 기준으로 측정 중이며, 표본이 쌓이면 공개됩니다.</div>
        <a class="lg-cta" href="#" data-demo>앱에서 진행 상황 보기</a>`;
    }
    return `<button class="lg-x" aria-label="닫기">✕</button>
      <div class="lg-cardhead"><b>${r.n}</b><span>최근 30일 · 종합</span></div>
      <div class="lg-schead">웨더리그 점수</div>${rowsHTML(g, false)}
      <a class="lg-cta" href="#" data-demo>우리 동네 전체 순위와 예보 받기</a>`;
  }
  function hudHTML(g) {
    const r = DATA.regions[g];
    if (collecting) {
      return `<button class="lg-x" aria-label="닫기">✕</button>
        <div class="lg-hudhead"><b>${r.n}</b></div>
        <div class="lg-collect"><b>순위를 집계하고 있습니다</b>
        새 채점 기준으로 측정 중입니다.</div>
        <a class="lg-hudcta" href="#" data-demo>앱에서 진행 상황 보기</a>`;
    }
    return `<button class="lg-x" aria-label="닫기">✕</button>
      <div class="lg-hudhead"><b>${r.n}</b><span>최근 30일 · 웨더리그 점수</span></div>
      ${rowsHTML(g, true)}
      <a class="lg-hudcta" href="#" data-demo>우리 동네 전체 순위와 예보 받기</a>`;
  }

  const card = $('lgCard');
  const hud = $('lgHud');
  function select(g, at) {
    selected = g;
    svg.querySelectorAll('path.sel').forEach((p) => p.classList.remove('sel'));
    const el = svg.querySelector(`path[data-g="${g}"]`);
    if (el) { el.classList.add('sel'); el.parentNode.appendChild(el); }
    if (isMobile()) {
      hud.innerHTML = hudHTML(g);
      hud.hidden = false;
    } else {
      card.innerHTML = cardHTML(g);
      card.hidden = false;
      const rc = wrap.getBoundingClientRect();
      let ax, ay;
      if (at) { ax = at.x - rc.left; ay = at.y - rc.top; }
      else {
        const b = DATA.regions[g].b;
        const src = svg.getBoundingClientRect();
        ax = ((b[0] + b[2] / 2 - vb.x) / vb.w) * src.width + src.left - rc.left;
        ay = ((b[1] + b[3] / 2 - vb.y) / vb.h) * src.height + src.top - rc.top;
      }
      const cw = card.offsetWidth, ch = card.offsetHeight;
      let x = ax + 16, y = ay - ch / 2;
      if (x + cw > rc.width - 8) x = ax - cw - 16;   // 가장자리 자동 플립
      x = Math.max(8, Math.min(x, rc.width - cw - 8));
      y = Math.max(8, Math.min(y, rc.height - ch - 8));
      card.style.left = `${x}px`;
      card.style.top = `${y}px`;
    }
  }
  function deselect() {
    selected = null;
    svg.querySelectorAll('path.sel').forEach((p) => p.classList.remove('sel'));
    card.hidden = true;
    hud.hidden = true;
  }
  document.addEventListener('click', (e) => {
    const t = e.target;
    if (t.closest?.('.lg-x')) { deselect(); return; }
    if (t.closest?.('[data-demo]')) {
      e.preventDefault();
      toast('앱 연결은 준비 중입니다');
    }
  });

  // ── 지역 검색 ───────────────────────────────────────────────────────
  const q = $('lgQ');
  const qList = $('lgQList');
  q.addEventListener('input', () => {
    const v = q.value.trim().replace(/\s+/g, '');
    if (!v || !DATA) { qList.hidden = true; return; }
    const hits = Object.entries(DATA.regions)
      .filter(([, r]) => r.n.replace(/\s+/g, '').includes(v))
      .slice(0, 8);
    qList.innerHTML = hits.map(([g, r]) =>
      `<button type="button" data-g="${g}">${r.n}</button>`).join('');
    qList.hidden = hits.length === 0;
  });
  qList.addEventListener('click', (e) => {
    const g = e.target?.dataset?.g;
    if (!g) return;
    qList.hidden = true;
    q.value = DATA.regions[g].n;
    q.blur();
    zoomToRegion(g);
    setTimeout(() => select(g), 280);
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest?.('.lg-search')) qList.hidden = true;
  });

  // ── 현재 위치 (좌표는 브라우저 안에서만 쓰고 즉시 폐기 — 서버 전송 없음) ──
  function inRing(x, y, ring) {
    let ins = false;
    for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      const xi = ring[i][0], yi = ring[i][1], xj = ring[j][0], yj = ring[j][1];
      if ((yi > y) !== (yj > y) && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi)
        ins = !ins;
    }
    return ins;
  }
  function judgeRegion(lon, lat) {
    for (const [g, polys] of Object.entries(judge)) {
      for (const rings of polys) {
        let ins = false;
        for (const ring of rings) if (inRing(lon, lat, ring)) ins = !ins;
        if (ins) return g;
      }
    }
    return null;
  }
  async function locateMe(btn) {
    if (!navigator.geolocation) {
      toast('이 브라우저에서는 위치 기능을 사용할 수 없습니다');
      return;
    }
    btn.disabled = true;
    try {
      if (!judge) {
        judge = await (await fetch(`${base}/league/judge-boundaries.json`,
          { cache: 'no-cache' })).json();
      }
      navigator.geolocation.getCurrentPosition((pos) => {
        btn.disabled = false;
        const lon = pos.coords.longitude, lat = pos.coords.latitude;
        const acc = pos.coords.accuracy || 0;
        const accTxt = acc >= 1000 ? `±${(acc / 1000).toFixed(1)}km` : `±${Math.round(acc)}m`;
        const g = judgeRegion(lon, lat);
        if (!g) {
          toast(`서비스 지역 밖입니다 · 위치 정확도 ${accTxt}`);
        } else if (acc > 1200) {
          // 대략적 위치(네트워크 측위)면 자동 선택하지 않는다 — 오판 경험 방지
          toast(`위치 정확도가 낮습니다 (${accTxt}) · 지역 검색을 이용해 주세요`);
        } else {
          toast(`${DATA.regions[g].n} · 위치 정확도 ${accTxt}`);
          zoomToRegion(g);
          setTimeout(() => select(g), 280);
        }
      }, () => {
        btn.disabled = false;
        toast('위치 권한이 거부되었습니다 · 지역 검색을 이용해 주세요');
      }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
    } catch {
      btn.disabled = false;
      toast('지역 경계 자료를 불러오지 못했습니다');
    }
  }
  $('lgLoc').addEventListener('click', (e) => locateMe(e.currentTarget));
  $('lgHere').addEventListener('click', (e) => locateMe(e.currentTarget));

  // ── 탭 전환 ─────────────────────────────────────────────────────────
  function showTab(nat) {
    $('tabNat').classList.toggle('on', nat);
    $('tabMap').classList.toggle('on', !nat);
    $('tabNat').setAttribute('aria-selected', String(nat));
    $('tabMap').setAttribute('aria-selected', String(!nat));
    $('secNat').hidden = !nat;
    $('secMap').hidden = nat;
    if (!nat) { fitCard(); scheduleLabels(); }
    else drawChart();
  }
  $('tabNat').addEventListener('click', () => showTab(true));
  $('tabMap').addEventListener('click', () => showTab(false));

  // ── 전국 리그: 시상대 · 순위 변화 차트 · 전체 순위 표 ────────────────
  const HIGHLIGHT = 5;      // 선을 굵게 그리는 상위 채널 수 (나머지는 흐리게)
  let natOrder = [];
  function buildNational() {
    const N = DATA.national;
    const codes = Object.keys(N.rank);
    const lastRank = (c) => N.rank[c][N.rank[c].length - 1];
    natOrder = codes.slice().sort((a, b) => lastRank(a) - lastRank(b));

    $('natTop').innerHTML = natOrder.slice(0, 3).map((c, i) => {
      const ch = DATA.channels[c];
      const sq = ch.i.endsWith('.svg');
      return `<div class="lg-pod lg-pod--${i + 1}">
        <span class="rk">${i + 1}위</span>
        <img class="ic lg-flag${sq ? ' lg-flag--sq' : ''}"
             style="width:${sq ? 40 : 44}px;height:${sq ? 40 : 30}px"
             src="${base}/league/ch/${ch.i}" alt="">
        <div class="nm">${ch.n}</div>
        <div class="sc">${N.score[c][N.score[c].length - 1]}
          <span class="unit">웨더리그 점수</span></div>
      </div>`;
    }).join('');

    const rows = natOrder.map((c, i) => {
      const delta = N.rank[c][0] - lastRank(c);      // + = 순위 상승
      const cls = delta > 0 ? 'up' : delta < 0 ? 'dn' : 'same';
      const txt = delta > 0 ? `+${delta}` : delta < 0 ? `${delta}` : '–';
      return `<tr class="${i === 0 ? 'top' : ''}">
        <td><span class="rk">${i + 1}위</span></td>
        <td><span class="ch">${chIcon(c)}${DATA.channels[c].n}</span></td>
        <td class="num"><span class="sc">${N.score[c][N.score[c].length - 1]}</span></td>
        <td class="num"><span class="dl dl--${cls}">${txt}</span></td></tr>`;
    }).join('');
    $('natTable').innerHTML = `<table class="lg-tbl">
      <thead><tr><th>순위</th><th>채널</th><th class="num">웨더리그 점수</th>
      <th class="num">30일 전 대비</th></tr></thead><tbody>${rows}</tbody></table>`;

    drawChart();
    addEventListener('resize', drawChart);
  }

  let chartGeom = null;
  function drawChart() {
    if (!DATA || $('secNat').hidden) return;
    const N = DATA.national;
    const host = $('natChart');
    const W = host.clientWidth || 640;
    const H = Math.max(260, Math.min(380, W * 0.5));
    const M = { t: 14, r: isMobile() ? 14 : 124, b: 26, l: 34 };
    const days = N.dates.length;
    const maxRank = Object.keys(N.rank).length;
    const px = (i) => M.l + (i / (days - 1)) * (W - M.l - M.r);
    const py = (r) => M.t + ((r - 1) / (maxRank - 1)) * (H - M.t - M.b);
    chartGeom = { W, H, M, days, px, py };

    const parts = [];
    for (const r of [1, 5, 10, maxRank]) {
      if (r > maxRank) continue;
      parts.push(`<line class="grid" x1="${M.l}" x2="${W - M.r}" y1="${py(r)}" y2="${py(r)}"/>`);
      parts.push(`<text class="axis" x="${M.l - 8}" y="${py(r) + 4}"
        text-anchor="end">${r}위</text>`);
    }
    for (const i of [0, Math.floor((days - 1) / 2), days - 1]) {
      const d = N.dates[i].slice(5).replace('-', '.');
      parts.push(`<text class="axis" x="${px(i)}" y="${H - 7}"
        text-anchor="${i === 0 ? 'start' : i === days - 1 ? 'end' : 'middle'}">${d}</text>`);
    }
    const line = (c) => N.rank[c].map((r, i) =>
      `${px(i).toFixed(1)},${py(r).toFixed(1)}`).join(' ');
    // 하위권을 먼저 흐리게 깔고 상위권을 위에 — 범례 없이 선 끝 이름으로 식별한다
    natOrder.slice(HIGHLIGHT).forEach((c) =>
      parts.push(`<polyline class="ln ln--sub" style="stroke:${DATA.channels[c].c}"
        points="${line(c)}"/>`));
    natOrder.slice(0, HIGHLIGHT).forEach((c) =>
      parts.push(`<polyline class="ln" style="stroke:${DATA.channels[c].c}"
        points="${line(c)}"/>`));
    natOrder.forEach((c, i) => {
      const lr = N.rank[c][days - 1];
      const top = i < HIGHLIGHT;
      if (top) {
        parts.push(`<circle class="dot" cx="${px(days - 1)}" cy="${py(lr)}" r="4.5"
          fill="${DATA.channels[c].c}"/>`);
      }
      if (!isMobile()) {   // 선 끝 이름표 (범례 대체)
        parts.push(`<text class="endlbl${top ? '' : ' endlbl--sub'}"
          x="${px(days - 1) + 11}" y="${py(lr) + 4}"
          style="fill:${DATA.channels[c].c}">${DATA.channels[c].n}</text>`);
      }
    });
    parts.push(`<line id="ctCross" class="cross" x1="0" x2="0" y1="${M.t}"
      y2="${H - M.b}" style="display:none"/>`);

    host.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img"
      aria-label="최근 30일 전국 순위 변화">${parts.join('')}</svg>
      <div id="ctTip" class="lg-cttip" hidden></div>`;
    host.querySelector('svg').addEventListener('pointermove', onChartHover);
    host.querySelector('svg').addEventListener('pointerleave', () => {
      const t = $('ctTip'); if (t) t.hidden = true;
      const cr = $('ctCross'); if (cr) cr.style.display = 'none';
    });
  }

  function onChartHover(e) {
    if (!chartGeom) return;
    const N = DATA.national;
    const rc = e.currentTarget.getBoundingClientRect();
    const { W, M, days, px, py } = chartGeom;
    const xv = ((e.clientX - rc.left) / rc.width) * W;
    let i = Math.round(((xv - M.l) / (W - M.l - M.r)) * (days - 1));
    i = Math.max(0, Math.min(days - 1, i));
    const cross = $('ctCross');
    cross.setAttribute('x1', px(i));
    cross.setAttribute('x2', px(i));
    cross.style.display = '';
    const top = natOrder.slice().sort((a, b) => N.rank[a][i] - N.rank[b][i]).slice(0, 3);
    const tipEl = $('ctTip');
    tipEl.innerHTML = `<div class="dt">${N.dates[i].replace(/-/g, '.')}</div>` +
      top.map((c) => `<div class="r"><span class="rk">${N.rank[c][i]}위</span>
        ${chIcon(c)}<span class="nm">${DATA.channels[c].n}</span>
        <span class="sc">${N.score[c][i]}</span></div>`).join('');
    tipEl.hidden = false;
    const hostRc = $('natChart').getBoundingClientRect();
    const sx = (px(i) / W) * rc.width + (rc.left - hostRc.left);
    let left = sx + 14;
    if (left + tipEl.offsetWidth > hostRc.width) left = sx - tipEl.offsetWidth - 14;
    tipEl.style.left = `${Math.max(0, left)}px`;
    tipEl.style.top = `${Math.max(0, py(1) - 8)}px`;
  }

  // ── 토스트 ──────────────────────────────────────────────────────────
  let toastTimer;
  function toast(msg) {
    const t = $('lgToast');
    t.textContent = msg;
    t.classList.add('on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('on'), 3600);
  }
</script>
