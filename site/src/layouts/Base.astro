---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** base 뒤에 붙는 경로. 홈 = '/', 블로그 = '/blog/' */
  path?: string;
  /** JSON-LD 등 head에 추가할 구조화 데이터 (문자열) */
  jsonLd?: string;
  /** 문서 종류. **글 상세만 'article'**, 나머지(랜딩·목록)는 'website'.
   *  카톡·페이스북 미리보기와 검색엔진이 "이건 기사다"를 이걸로 구분한다
   *  (2026-08-09 신설 — 그전에는 글 상세도 website로 나가고 있었다). */
  ogType?: 'website' | 'article';
  /** 발행일 ISO 문자열 — ogType이 'article'일 때만 쓴다 */
  publishedTime?: string;
  /** 이 페이지 전용 미리보기 이미지 (public 기준 경로). 없으면 사이트 공통 og 이미지 */
  image?: string;
}

const {
  title,
  description,
  path = '/',
  jsonLd,
  ogType = 'website',
  publishedTime,
  image,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/** 미리보기(dev) 사본인가 — base가 /preview면 초안까지 들어 있는 확인용 빌드다.
 *  ⚠ 이 사본은 **검색에 절대 노출되면 안 된다**: noindex(아래) + robots.txt Disallow +
 *    사이트맵 미생성, 3중으로 막는다. 판단 기준은 astro.preview.config.mjs 주석 참조. */
const isPreview = base === '/preview';
// 방침·약관은 별도 저장소(weatherleague-policy)에 남는다 — Play Console 등록 URL 보존
const POLICY = '/weatherleague-policy';
const canonical = new URL(base + path, Astro.site).href;
// 링크 미리보기 이미지. ⚠ **교체할 때는 파일명을 바꾼다** — 카톡·페이스북 등이
// URL 단위로 미리보기를 며칠 캐시하므로, 같은 이름으로 덮으면 옛 이미지가 계속 뜬다
// (2026-08-08 교체: og.png → og-2608.png, 구 파일은 이력용으로 남겨 둠).
const ogImage = new URL(`${base}${image ?? '/og-2608.png'}`, Astro.site).href;
const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.weatherleague.app';
const MAIL = 'contact.weatherleague@gmail.com';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPreview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    {/* 네이버 서치어드바이저 소유확인 (2026-08-11 등록) — 지우면 네이버 쪽 등록이 풀린다 */}
    <meta name="naver-site-verification" content="a242fccb010f8c9e560c76b81f1d91cd4373cc0b" />
    <link rel="icon" type="image/png" href={`${base}/icon.png`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="웨더리그" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    {
      isPreview && (
        <div class="preview-bar">
          미리보기 — 발행 전 초안이 포함된 확인용 사본입니다. 검색에는 잡히지 않아요.
          <a href="https://weatherleague.kr/">실제 사이트로</a>
        </div>
      )
    }
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={`${base}/`}>
          <img src={`${base}/icon.png`} alt="" width="30" height="30" />
          웨더리그
        </a>
        <nav class="nav" aria-label="주 메뉴">
          <a class="nav-link" href={`${base}/blog/`}>블로그</a>
          {/* ⚠ mailto는 **메일 앱이 없는 PC에서 아무 반응도 하지 않는다**(윈도우 실측 2026-08-10).
              누른 사람 입장에선 버튼이 고장 난 것으로 보인다. 그래서 누를 때 주소를 클립보드에
              함께 복사하고 안내를 띄운다 — 메일 앱이 열리면 그대로 쓰면 되고,
              안 열려도 주소는 손에 남는다. (스크립트는 body 끝) */}
          <a
            class="btn btn-navy"
            href={`mailto:${MAIL}?subject=${encodeURIComponent('[웨더리그 제휴 문의]')}`}
            data-mail={MAIL}>제휴 문의</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <div class="f-brand">
            <img src={`${base}/icon.png`} alt="" width="24" height="24" />
            웨더리그
          </div>
          <p class="f-copy">© 2026 웨더리그</p>
        </div>
        <nav class="f-links" aria-label="사이트 정보">
          <a href={`${POLICY}/privacy.html`}>개인정보처리방침</a>
          <a href={`${POLICY}/terms.html`}>이용약관</a>
          {/* 종전엔 '문의'라는 글자만 있어서, 메일 앱이 없는 PC에서는 주소를 알 길이 아예 없었다.
              주소를 그대로 적어 두면 눌러도 되고 복사해 가도 된다. */}
          <a href={`mailto:${MAIL}`} data-mail={MAIL}>{MAIL}</a>
        </nav>
      </div>
    </footer>

    <script>
      // 헤더: 스크롤하면 그림자
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });

      // 스크롤 등장 연출 — 화면을 벗어나면 초기화해서, 다시 스크롤해 오면 재생된다
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            e.target.classList.toggle('in', e.isIntersecting);
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -30px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // 메일 링크: 누를 때 주소를 클립보드에 복사하고, 무슨 일이 있었는지 알린다.
      //
      // 왜: mailto는 기본 메일 앱이 지정되지 않은 PC에서 **아무 일도 일어나지 않는다**
      //     (윈도우 실측 2026-08-10). 누른 사람에겐 버튼이 고장 난 것으로 보인다.
      //     mailto 자체는 막지 않는다 — 메일 앱이 있으면 평소대로 열린다.
      //
      // ⚠ 안내는 **복사 성공 여부와 무관하게 항상** 띄운다. 복사가 실패했을 때만 조용하면
      //   원래 고치려던 그 증상(눌러도 아무 반응 없음)이 그대로 재현된다.
      //   복사는 브라우저 정책상 실패할 수 있다(권한·포커스). 그때는 주소를 읽어 가면 된다.
      let toastTimer: number | undefined;

      function showToast(msg: string) {
        let t = document.getElementById('mailToast');
        if (!t) {
          t = document.createElement('div');
          t.id = 'mailToast';
          t.className = 'mail-toast';
          t.setAttribute('role', 'status');
          document.body.appendChild(t);
        }
        t.textContent = msg;
        t.classList.add('on');
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => t?.classList.remove('on'), 4000);
      }

      document.querySelectorAll<HTMLAnchorElement>('a[data-mail]').forEach((el) => {
        el.addEventListener('click', async () => {
          const addr = el.dataset.mail || '';
          let copied = false;
          try {
            await navigator.clipboard.writeText(addr);
            copied = true;
          } catch {
            copied = false;
          }
          showToast(copied ? `메일 주소를 복사했어요 — ${addr}` : `메일 주소: ${addr}`);
        });
      });
    </script>
  </body>
</html>
